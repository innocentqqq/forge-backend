# Copy to .env and fill in real values. Expo only exposes EXPO_PUBLIC_* to the app.

# Your Supabase project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Supabase publishable/anon key. NEVER put the service_role or sb_secret_ key in a mobile app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# mock (default) runs the in-app demo; real calls the Forge API below.
EXPO_PUBLIC_API_MODE=mock

# Optional API override. By default, the app calls the forge-api Supabase Edge Function.
# EXPO_PUBLIC_API_URL=https://YOUR-PROJECT-ref.supabase.co/functions/v1/forge-api
