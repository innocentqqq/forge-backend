{
  "name": "forge",
  "version": "0.2.0",
  "private": true,
  "description": "Forge — 3D printing marketplace: Expo app, Node API, and shared types",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run start -w @forge/mobile",
    "dev:web": "npm run web -w @forge/mobile",
    "dev:api": "npm run dev -w @forge/api",
    "android": "npm run android -w @forge/mobile",
    "ios": "npm run ios -w @forge/mobile",
    "build": "npm run build -w @forge/api",
    "start:api": "npm run start -w @forge/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test -w @forge/api",
    "format": "npm run format -w @forge/api",
    "format:check": "npm run format:check -w @forge/api",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  }
}
